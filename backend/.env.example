# 복사해서 .env 로 만들고 값을 채운다. .env 는 git 에 올라가지 않는다.
APP_ENV=development
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon key>
# ES256(JWKS) 프로젝트는 비워 둔다. 구형 HS256 프로젝트만 대시보드 JWT Secret 입력
SUPABASE_JWT_SECRET=
# JSON 배열 문자열. 같은 네트워크 팀원 FE 주소를 추가 (예: "http://192.168.0.12:3000")
CORS_ORIGINS=["http://localhost:3000"]
